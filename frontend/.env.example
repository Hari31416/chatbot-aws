# Dev Server port
PORT=3000

# Backend API Endpoint Base URL (Local API or AWS API Gateway HTTP API)
VITE_API_BASE_URL=http://localhost:8080

# Streaming Function App URL (Direct AWS Lambda Function URL for response streaming)
# Falls back to VITE_API_BASE_URL if not specified
VITE_FUNCTION_URL=http://localhost:8080

# Allowed hosts for development (comma-separated, optional)
ALLOWED_HOSTS=localhost,127.0.0.1

# Clerk Configuration
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
